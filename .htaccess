RewriteEngine On
RewriteRule ^pagar/(.*)$ painel/pagamentos/index.php?id_conta=$1 [L]
RewriteRule ^cadastro(.*)$ painel/cadastro.php [L]
RewriteRule ^acesso(.*)$ acesso.php [L]
RewriteRule ^login(.*)$ login.php [L]
RewriteRule ^simulador(.*)$ simulador.php [L]

